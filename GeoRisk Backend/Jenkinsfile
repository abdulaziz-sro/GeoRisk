def writeAllureMetadata() {
    def resultsDirectory = 'target/allure-results'
    def gitCommit = env.GIT_COMMIT ?: 'unbekannt'

    def geoServerVersion = env.RESOLVED_GEOSERVER_VERSION ?: 'unbekannt'
    def lwasVersion = env.RESOLVED_LWAS_VERSION ?: 'unbekannt'

    def reportName = "OGC Tests | GS ${geoServerVersion} | LWAS ${lwasVersion} | ${params.TEST_ENVIRONMENT}"

    sh """
        mkdir -p '${resultsDirectory}'
    """

    def environmentProperties = """
        Testumgebung=${params.TEST_ENVIRONMENT}
        GeoServer.URL=${env.GEOSERVER_URL}
        GeoServer.Version=${geoServerVersion}
        LWAS.URL=${env.LWAS_URL}
        LWAS.Version=${lwasVersion}
        Git.Commit=${gitCommit}
    """.stripIndent().trim() + '\n'

    def executorJson =
        groovy.json.JsonOutput.prettyPrint(
            groovy.json.JsonOutput.toJson([
                name       : 'Jenkins',
                type       : 'jenkins',
                buildOrder : env.BUILD_NUMBER as Integer,
                buildName  : "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                buildUrl   : env.BUILD_URL ?: '',
                reportUrl  : "${env.BUILD_URL ?: ''}allure/",
                reportName : reportName
            ])
        )

    writeFile(
        file: "${resultsDirectory}/environment.properties",
        text: environmentProperties,
        encoding: 'UTF-8'
    )

    writeFile(
        file: "${resultsDirectory}/executor.json",
        text: executorJson,
        encoding: 'UTF-8'
    )
}


def determineGeoServerVersion(String geoServerUrl) {
    try {
        String versionXml

        withCredentials([
            usernamePassword(
                credentialsId: env.GEOSERVER_CREDENTIALS_ID,
                usernameVariable: 'GS_USERNAME',
                passwordVariable: 'GS_PASSWORD'
            )
        ]) {
            versionXml = sh(
                script: '''
                    curl \
                        --fail \
                        --silent \
                        --user "$GS_USERNAME:$GS_PASSWORD" \
                        --header "Accept: text/xml" \
                        "$GEOSERVER_URL/rest/about/version.xml"
                ''',
                returnStdout: true
            ).trim()
        }

        def matcher = versionXml =~ /(?s)<resource[^>]*name="GeoServer"[^>]*>.*?<Version>\s*([^<]+)\s*<\/Version>/

        if (matcher.find()) {
            return matcher.group(1).trim()
        }

        echo """
        GeoServer-Version wurde in der REST-Antwort
        nicht gefunden.
        """.stripIndent()

        return 'unbekannt'
    } catch (Exception exception) {
        echo """
        GeoServer-Version konnte nicht automatisch ermittelt werden.
        Ursache: ${exception.message}
        Es wird der Wert 'unbekannt' verwendet.
        """.stripIndent()

        return 'unbekannt'
    }
}

pipeline {
    agent { label 'bsa-slave' }
    tools { maven 'maven' }

    parameters {
        choice(
            name: 'TEST_ENVIRONMENT',
            choices: [
                'lokal',
                'SV-TEST',
                'SV-QS'
            ],
            description:
                'Umgebung, gegen die die Tests ausgeführt werden'
        )

        string(
            name: 'GEOSERVER_VERSION',
            defaultValue: '',
            description: 'Optional. Leer lassen für automatische Ermittlung'
        )

        string(
            name: 'LWAS_VERSION',
            defaultValue: '',
            description: 'Optional. Leer lassen für lokal oder unbekannt'
        )
    }

    environment { GEOSERVER_CREDENTIALS_ID = 'geoserver-admin' }

    stages {
        stage('Umgebung vorbereiten') {
            steps {
                script {
                    def environments = [
                        'lokal': [
                            geoServerUrl: 'http://localhost:8080/geoserver',
                            lwasUrl: 'https://localhost:8443'
                        ],

                        'SV-TEST': [
                            geoServerUrl: 'http://localhost:8081/geoserver',
                            lwasUrl: 'https://localhost:8443'
                        ],

                        'SV-QS': [
                            geoServerUrl: 'http://localhost:8082/geoserver',
                            lwasUrl: 'https://localhost:8443'
                        ]
                    ]

                    def selectedEnvironment = environments[params.TEST_ENVIRONMENT]

                    if (selectedEnvironment == null) {
                        error(
                            'Unbekannte Testumgebung: ' + params.TEST_ENVIRONMENT
                        )
                    }

                    env.GEOSERVER_URL = selectedEnvironment.geoServerUrl
                    env.LWAS_URL = selectedEnvironment.lwasUrl

                    env.RESOLVED_GEOSERVER_VERSION = params.GEOSERVER_VERSION?.trim()
                    env.RESOLVED_LWAS_VERSION = params.LWAS_VERSION?.trim()
                    env.TEST_ENVIRONMENT = params.TEST_ENVIRONMENT

                    if (!env.RESOLVED_GEOSERVER_VERSION) {
                        if (params.TEST_ENVIRONMENT == 'lokal') {
                            env.RESOLVED_GEOSERVER_VERSION = 'lokal'
                        } else {
                            env.RESOLVED_GEOSERVER_VERSION =
                                determineGeoServerVersion(
                                    env.GEOSERVER_URL
                                )
                        }
                    }

                    if (!env.RESOLVED_LWAS_VERSION) {
                        env.RESOLVED_LWAS_VERSION =
                            params.TEST_ENVIRONMENT == 'lokal'
                                ? 'lokal'
                                : 'unbekannt'
                    }

                    echo """
                    Verwendete Testumgebung:
                    Umgebung:         ${params.TEST_ENVIRONMENT}
                    GeoServer URL:     ${env.GEOSERVER_URL}
                    GeoServer Version: ${env.RESOLVED_GEOSERVER_VERSION}
                    LWAS URL:          ${env.LWAS_URL}
                    LWAS Version:      ${env.RESOLVED_LWAS_VERSION}
                    """.stripIndent()
                }
            }
        }

        stage('Maven Test') {
            steps {
                configFileProvider([
                    configFile(
                        fileId: 'bsa-ci-slave01-maven-settings',
                        variable: 'ENV_MAVEN_SETTINGS'
                    )
                ]) {
                    dir('GeoRisk Backend') {
                        sh '''
                            mvn \
                                --settings "$ENV_MAVEN_SETTINGS" \
                                clean test \
                                -Dtest.environment="$TEST_ENVIRONMENT" \
                                -Dgeoserver.url="$GEOSERVER_URL" \
                                -Dlwas.url="$LWAS_URL" \
                                -Dgeoserver.version="$RESOLVED_GEOSERVER_VERSION" \
                                -Dlwas.version="$RESOLVED_LWAS_VERSION"
                        '''
                    }
                }
            }
        }

        stage('Allure-Metadaten erzeugen') {
            steps {
                dir('GeoRisk Backend') {
                    script {
                        writeAllureMetadata()
                    }
                }
            }
        }
    }
    
    post {
        always {
            dir('GeoRisk Backend') {
                script {
                    if (fileExists('target/allure-results')) {
                        /*
                        * Metadaten erneut schreiben, falls eine vorherige
                        * Stage fehlgeschlagen ist oder die Dateien fehlen.
                        */
                        writeAllureMetadata()

                        def geoServerVersion = env.RESOLVED_GEOSERVER_VERSION ?: 'unbekannt'

                        def lwasVersion = env.RESOLVED_LWAS_VERSION ?: 'unbekannt'

                        def reportName =
                            "OGC Tests | GS ${geoServerVersion} | LWAS ${lwasVersion} | ${params.TEST_ENVIRONMENT}"

                        allure(
                            reportBuildPolicy: 'ALWAYS',
                            results: [
                                [
                                    path: 'target/allure-results'
                                ]
                            ],
                            reportName: reportName
                        )
                    } else {
                        echo """
                        Kein Allure-Ergebnisverzeichnis vorhanden.
                        Der Allure-Report kann nicht erzeugt werden.
                        """.stripIndent()
                    }
                }
            }
        }
    }
}