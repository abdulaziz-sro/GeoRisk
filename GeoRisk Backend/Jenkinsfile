pipeline{
    agent {label 'bsa-slave'}
    tools {maven 'maven'}
    
        
    parameters {
        choice(
            name: 'TEST_ENVIRONMENT',
            choices: [
                'lokal',
                'SV-TEST',
                'SV-QS'
            ],
            description: 'Umgebung, gegen die die Tests ausgeführt werden'
        )

        string(
            name: 'GEOSERVER_URL',
            defaultValue: 'http://localhost:8080/geoserver',
            description: 'Basis-URL des GeoServers'
        )

        string(
            name: 'LWAS_URL',
            defaultValue: 'https://localhost:8443',
            description: 'Basis-URL der LWAS-Instanz'
        )

        string(
            name: 'GEOSERVER_VERSION',
            defaultValue: '',
            description: 'Optional. Leer lassen für automatische Ermittlung'
        )

        string(
            name: 'LWAS_VERSION',
            defaultValue: '',
            description: 'LWAS-Version'
        )
    }

    environment {
        ALLURE_RESULTS_DIR = 'target/allure-results'

        /*
         * Den Credentials-Namen später an die tatsächliche
         * Jenkins-Credentials-ID anpassen.
         */
        GEOSERVER_CREDENTIALS_ID = 'geoserver-admin'
    }

    stages {
        stage('Checkout') {
            steps{
                git(
                    url: 'https://github.com/abdulaziz-sro/GeoRisk.git',
                    branch: 'feature/allure-report'
                )
            }
        }

        stage('Umgebung vorbereiten') {
            steps {
                script {
                    env.RESOLVED_GEOSERVER_VERSION =
                        params.GEOSERVER_VERSION?.trim()

                    env.RESOLVED_LWAS_VERSION =
                        params.LWAS_VERSION?.trim()

                    if (!env.RESOLVED_GEOSERVER_VERSION) {
                        if (params.TEST_ENVIRONMENT == 'lokal') {
                            env.RESOLVED_GEOSERVER_VERSION = 'lokal'
                        } else {
                            env.RESOLVED_GEOSERVER_VERSION =
                                determineGeoServerVersion(
                                    params.GEOSERVER_URL
                                )
                        }
                    }

                    if (!env.RESOLVED_LWAS_VERSION) {
                        env.RESOLVED_LWAS_VERSION =
                            params.TEST_ENVIRONMENT == 'lokal'
                                ? 'lokal'
                                : 'unbekannt'
                    }

                    echo """
                    Verwendete Testumgebung:
                    Umgebung:         ${params.TEST_ENVIRONMENT}
                    GeoServer URL:     ${params.GEOSERVER_URL}
                    GeoServer Version: ${env.RESOLVED_GEOSERVER_VERSION}
                    LWAS URL:          ${params.LWAS_URL}
                    LWAS Version:      ${env.RESOLVED_LWAS_VERSION}
                    """.stripIndent()
                }
            }
        }

        stage('Tests ausführen') {
            steps {
                script {
                    if (isUnix()) {
                        sh """
                            mvn clean test \
                                -Dtest.environment='${params.TEST_ENVIRONMENT}' \
                                -Dgeoserver.url='${params.GEOSERVER_URL}' \
                                -Dlwas.url='${params.LWAS_URL}' \
                                -Dgeoserver.version='${env.RESOLVED_GEOSERVER_VERSION}' \
                                -Dlwas.version='${env.RESOLVED_LWAS_VERSION}'
                        """
                    } else {
                        bat """
                            mvn clean test ^
                                -Dtest.environment="${params.TEST_ENVIRONMENT}" ^
                                -Dgeoserver.url="${params.GEOSERVER_URL}" ^
                                -Dlwas.url="${params.LWAS_URL}" ^
                                -Dgeoserver.version="${env.RESOLVED_GEOSERVER_VERSION}" ^
                                -Dlwas.version="${env.RESOLVED_LWAS_VERSION}"
                        """
                    }
                }
            }
        }

        stage('Allure-Metadaten erzeugen') {
            steps {
                script {
                    def gitCommit = env.GIT_COMMIT ?: 'unbekannt'

                    def reportName =
                        "OGC Tests | "
                        + "GS ${env.RESOLVED_GEOSERVER_VERSION} | "
                        + "LWAS ${env.RESOLVED_LWAS_VERSION} | "
                        + "${params.TEST_ENVIRONMENT}"

                    def environmentProperties = """
                        Testumgebung=${params.TEST_ENVIRONMENT}
                        GeoServer.URL=${params.GEOSERVER_URL}
                        GeoServer.Version=${env.RESOLVED_GEOSERVER_VERSION}
                        LWAS.URL=${params.LWAS_URL}
                        LWAS.Version=${env.RESOLVED_LWAS_VERSION}
                        Jenkins.Job=${env.JOB_NAME}
                        Jenkins.Build=${env.BUILD_NUMBER}
                        Git.Commit=${gitCommit}
                    """.stripIndent().trim() + '\n'

                    def executorJson = groovy.json.JsonOutput.prettyPrint(
                        groovy.json.JsonOutput.toJson([
                            name       : 'Jenkins',
                            type       : 'jenkins',
                            buildOrder : env.BUILD_NUMBER as Integer,
                            buildName  : "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            buildUrl   : env.BUILD_URL ?: '',
                            reportUrl  : "${env.BUILD_URL ?: ''}allure",
                            reportName : reportName
                        ])
                    )

                    writeFile(
                        file: "${env.ALLURE_RESULTS_DIR}/environment.properties",
                        text: environmentProperties,
                        encoding: 'UTF-8'
                    )

                    writeFile(
                        file: "${env.ALLURE_RESULTS_DIR}/executor.json",
                        text: executorJson,
                        encoding: 'UTF-8'
                    )

                    echo "Allure-Metadaten wurden erstellt."
                    echo "Reportname: ${reportName}"
                }
            }
        }

        stage('Allure-Ergebnisse prüfen') {
            steps {
                script {
                    if (isUnix()) {
                        sh """
                            echo "Inhalt von ${ALLURE_RESULTS_DIR}:"
                            find "${ALLURE_RESULTS_DIR}" \
                                -maxdepth 1 \
                                -type f \
                                -print
                        """
                    } else {
                        bat """
                            echo Inhalt von %ALLURE_RESULTS_DIR%:
                            dir /b "%ALLURE_RESULTS_DIR%"
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def reportName =
                    "OGC Tests | "
                    + "GS ${env.RESOLVED_GEOSERVER_VERSION ?: 'unbekannt'} | "
                    + "LWAS ${env.RESOLVED_LWAS_VERSION ?: 'unbekannt'} | "
                    + "${params.TEST_ENVIRONMENT}"

                allure(
                    reportBuildPolicy: 'ALWAYS',
                    results: [
                        [
                            path: env.ALLURE_RESULTS_DIR
                        ]
                    ],
                    reportName: reportName
                )
            }
        }
    }
}


/*
 * Die Methode wird nur verwendet, wenn:
 *
 * 1. keine GeoServer-Version als Parameter angegeben wurde
 * 2. die Ausführung nicht lokal erfolgt
 */
String determineGeoServerVersion(String geoServerUrl) {
    try {
        String versionXml

        withCredentials([
            usernamePassword(
                credentialsId: env.GEOSERVER_CREDENTIALS_ID,
                usernameVariable: 'GS_USERNAME',
                passwordVariable: 'GS_PASSWORD'
            )
        ]) {
            if (isUnix()) {
                versionXml = sh(
                    script: """
                        curl --fail --silent \
                            --user "\$GS_USERNAME:\$GS_PASSWORD" \
                            --header "Accept: text/xml" \
                            "${geoServerUrl}/rest/about/version.xml"
                    """,
                    returnStdout: true
                ).trim()
            } else {
                versionXml = powershell(
                    script: """
                        \$pair = "\${env:GS_USERNAME}:\${env:GS_PASSWORD}"

                        \$encodedCredentials = :ToBase64String(
                            [Text.Encoding]::ASCII.GetBytes(\$pair)
                        )

                        \$headers = @{
                            Authorization = "Basic \$encodedCredentials"
                            Accept = "text/xml"
                        }

                        Invoke-RestMethod `
                            -Uri "${geoServerUrl}/rest/about/version.xml" `
                            -Headers \$headers
                    """,
                    returnStdout: true
                ).trim()
            }
        }

        def matcher = versionXml =~
            /(?s)<resource[^>]*name="GeoServer"[^>]*>.*?<Version>\s*([^<]+)\s*<\/Version>/

        if (matcher.find()) {
            return matcher.group(1).trim()
        }

        echo 'GeoServer-Version wurde in der REST-Antwort nicht gefunden.'
        return 'unbekannt'
    } catch (Exception exception) {
        echo """
        GeoServer-Version konnte nicht automatisch ermittelt werden.
        Ursache: ${exception.message}
        Es wird der Wert 'unbekannt' verwendet.
        """.stripIndent()

        return 'unbekannt'
    }
}